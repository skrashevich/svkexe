# Replace example.com with YOUR own domain, with base + wildcard DNS to this host.
DOMAIN=example.com
ACME_EMAIL=admin@example.com
CLOUDFLARE_API_TOKEN=
# Generate independently: openssl rand -hex 32
GATEWAY_ENC_KEY=
LLM_INTERNAL_TOKEN=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Generate: openssl rand -hex 24
BOOTSTRAP_ADMIN_PASSWORD=
SSH_PORT=2222
# Optional: public gateway IPs when DOMAIN resolves through a proxy/CDN.
GATEWAY_PUBLIC_IPS=
OPENROUTER_API_KEY=
# Used with: docker compose --profile monitoring up -d
GRAFANA_ADMIN_PASSWORD=
